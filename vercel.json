{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,

  "git": {
    "deploymentEnabled": {
      "Oris": true,
      "weriframe": false
    }
  },

  "functions": {
    "api/proxy.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },

  "regions": ["fra1"],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), autoplay=(self), fullscreen=(self), display-capture=(self)" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|webp|woff2|woff|ttf|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/downloader/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=300" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/proxy" },
    { "source": "/downloader/:hash", "destination": "/api/proxy" }
  ],

  "redirects": [
    { "source": "/658234/", "destination": "/658234", "permanent": true },
    { "source": "/r/:slug", "destination": "/api/redirects/:slug", "permanent": false },
    { "source": "/downloader", "destination": "/admin", "permanent": false },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ]
}